+  await alice.preparerAppareil();
+
+  const bob = new AgentFictif('kabore.f', AGENTS_DEMO.find((a) => a.identifiant === 'kabore.f').totp);
+  bob.moi = await bob.connecter();
+  // Appareil DÉCLARÉ mais sans clés jetables publiées : exactement l'état
+  // d'un navigateur à moitié initialisé (ou connecté après l'envoi).
+  await bob.preparerAppareil(true);
+
+  const rDirect = await requete('/api/direct', {
+    method: 'POST', cookie: alice.cookie, corps: { avec: 'kabore.f' },
+  });
+  assert.ok([200, 201].includes(rDirect.statut), 'conversation directe');
+  const salon = rDirect.donnees.salon_id;
+
+  // Alice crée la session Megolm et envoie : son partage vers l'appareil de
+  // Bob échoue silencieusement (aucune clé jetable à réclamer).
+  const idMsg = await alice.envoyerMessage(salon, 'rattrapage-salut-7f3a');
+  assert.ok(idMsg, 'message envoyé sans que la clé ait pu être partagée');
+
+  // Bob, côté client : le message reste indéchiffrable — état de la capture.
+  await bob.synchroniser();
+  const avant = await bob.lireMessages(salon);
+  const bloque = avant.find((m) => m.env.id === idMsg);
+  assert.ok(bloque && bloque.clair === null, 'sans rattrapage, le message est « clé de salon non reçue »');
+
+  // ——— Rattrapage (nouvelle logique du client) ———
+  // 1. Bob termine son initialisation : ses clés jetables sont publiées.
+  bob.gc.genererClesJetables(10);
+  await requete('/api/keys/upload', {
+    method: 'POST', cookie: bob.cookie,
+    corps: { appareil_id: bob.appareilId, cles: bob.gc.clesJetablesAPublier() },
+  });
+
+  // 2. Bob demande la clé manquante à l'émetteur du message (demande_cle).
+  await bob.demanderCleManquante(salon, bloque.env);
+
+  // 3. Alice traite la demande et re-partage la clé exportée (index 0).
+  await alice.synchroniser();
+
+  // 4. Bob reçoit la clé, l'importe (format exporté) et déchiffre TOUT :
+  //    y compris le message envoyé AVANT le rattrapage.
+  await bob.synchroniser();
+  const apres = await bob.lireMessages(salon);
+  assert.ok(apres.some((m) => m.clair?.texte === 'rattrapage-salut-7f3a'),
+    'le message envoyé avant le rattrapage est déchiffré après installation de la clé');
+
+  // 5. Le re-partage à chaque envoi couvre aussi les messages suivants.
+  await alice.envoyerMessage(salon, 'rattrapage-cc-9d2b');
+  await bob.synchroniser();
+  const fin = await bob.lireMessages(salon);
+  assert.ok(fin.some((m) => m.clair?.texte === 'rattrapage-cc-9d2b'),
+    'les messages suivants arrivent avec leur clé de session');
+});
-- 
